<?xml version="1.0" encoding="utf-8"?>

<odoo noupdate="1">
    <record id="cron_membership_send_alert_email" model="ir.cron">
        <field name="name">Membership: Send alert email </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="model_id" ref="model_res_partner" />
        <field name="code">model.cron_send_alert_email()</field>
    </record>
    <record id="cron_membership_send_suspended_email" model="ir.cron">
        <field name="name">Membership: Send suspended email </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="model_id" ref="model_res_partner" />
        <field name="code">model.cron_send_suspended_email()</field>
    </record>
</odoo>
