<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_inform_tree" model="ir.ui.view">
        <field name="name">res.partner.inform.tree</field>
        <field name="model">res.partner.inform</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_res_partner_inform_form" model="ir.ui.view">
        <field name="name">res.partner.inform.form</field>
        <field name="model">res.partner.inform</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="view_res_partner_inform_search">
        <field name="name">res.partner.inform.search</field>
        <field name="model">res.partner.inform</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_res_partner_inform">
        <field name="name">Partner Inform</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner.inform</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        name="Partner Inform"
        sequence="40"
        id="menu_res_partner_inform"
        action="action_res_partner_inform"
        parent="coop_shift.menu_shift_configuration"
        />
</odoo>
